# Copy to .env (git-ignored) and fill in. The tools in tools/ read it; real environment variables win over it.

# Your own copy of Morrowind: the folder holding Morrowind.ini and "Data Files". Required to convert game data.
MW3DS_MORROWIND_DIR=

# MSYS2 install (the folder with usr\bin\bash.exe), with devkitPro installed in it. Required to build.
MW3DS_MSYS2_DIR=

# Folder holding makerom.exe (and bannertool.exe). Required to build a CIA. Leave blank and tools/build/setup.ps1 downloads makerom for you.
MW3DS_CTR_TOOLS_DIR=

# Azahar emulator folder (portable install, containing azahar.exe). Required to run tests / play in the emulator.
MW3DS_EMU_DIR=

# Extra Azahar copies for parallel sweeps (tools/test/sweep-par.ps1), comma separated. The main copy is MW3DS_EMU_DIR.
MW3DS_EMU_DIRS=

# Optional: full path of tex3ds if it is not under devkitPro. Optional: MW3DS_OUT overrides the converted-data folder.
TEX3DS=
