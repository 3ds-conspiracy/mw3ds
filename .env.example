# Copy to .env (git-ignored) and fill in. The tools in tools/ read it; real environment variables win over it.

# Your own copy of Morrowind: the folder holding Morrowind.ini and "Data Files". Required to convert game data.
MW3DS_MORROWIND_DIR=

# MSYS2 install (the folder with usr\bin\bash.exe), with devkitPro installed in it. Required to build.
MW3DS_MSYS2_DIR=

# Folder holding makerom.exe (and bannertool.exe). Required to build a CIA. Leave blank and tools/build/setup.py downloads makerom for you.
MW3DS_CTR_TOOLS_DIR=

# Azahar emulator folder (portable install, containing azahar.exe). Required to run tests / play in the emulator.
MW3DS_EMU_DIR=

# Extra Azahar copies for parallel sweeps (tools/test/sweep_par.py), comma separated. The main copy is MW3DS_EMU_DIR.
MW3DS_EMU_DIRS=

# Optional: plugins (.esp) from Data Files to convert with Morrowind.esm, ";" separated, in load order
# (e.g. Siege at Firemoth.esp;master_index.esp). Plugins needing Tribunal.esm or Bloodmoon.esm are refused.
MW3DS_PLUGINS=

# Optional: the code page of your Morrowind.esm's text, as OpenMW's --encoding: win1252 (default: English, German,
# French ...), win1250 (Polish, Czech ...) or win1251 (Russian).
MW3DS_ENCODING=

# Optional: full path of tex3ds if it is not under devkitPro. Optional: MW3DS_OUT overrides the converted-data folder.
TEX3DS=

# Optional, only for tools/build/make_art.py (redrawing the HOME menu icon and 3D banner): the blender executable
# if Blender is not in its standard install folder, and a checkout of https://github.com/skyfloogle/pycgfx
MW3DS_BLENDER=
MW3DS_PYCGFX=
