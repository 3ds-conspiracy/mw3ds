; Cell geometry: pre-lit vertices (lighting baked into the vertex color).

; Uniforms
.fvec projection[4], modelView[4]
.fvec uvOffset                  ; added to the texture coordinates (scrolling water and clouds)
.fvec fogVec                    ; eye-space position . fogVec = 0 where fog starts, 1 where it is solid
.fvec posOffset, posScale       ; packed s16 vertices: position = posOffset + value * posScale
.fvec uvScale                   ; texture coordinate = value * uvScale (1 for float vertices)
.fvec tint                      ; colour scale: day and night outdoors (1 indoors)
.fvec lightPos                  ; the light the player carries: eye-space xyz, w = 1 / radius squared
.fvec lightColor                ; its colour (0 = none)

; Constants
.constf consts(0.0, 1.0, 0.00392156862, 0.5)
.alias  ones      consts.yyyy
.alias  inv255    consts.zzzz
.alias  half      consts.wwww

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1           ; x: fog amount, looked up in the fog ramp texture (renderer.cpp)
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	; r0 = vec4(posOffset + inpos * posScale, 1)
	mul r0.xyz, posScale, inpos
	add r0.xyz, posOffset, r0
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov r2, intex
	mul r2.xy, uvScale, r2
	add outtc0, uvOffset, r2

	; Linear distance fog from the eye-space depth: (fog, 0.5, 0, 0). Built in a temporary and
	; written to the output whole: the real PICA hangs when any component of an output register is
	; left unwritten (emulators don't care), which froze the game on its first 3D frame
	mov r3, consts.xxxx
	dp4 r3.x, fogVec, r1
	mov r3.y, half
	mov outtc1, r3

	; Unsigned byte colors arrive as 0..255; scaled by the time of day's tint, plus the carried light
	; falling off with distance: lightColor x max(0, 1 - distance^2 / radius^2) (written whole; no
	; square roots: rsq of a zero distance hung the GPU)
	mul r4, inv255, inclr
	mul r4, tint, r4
	add r5, -lightPos, r1
	mov r5.w, consts.x
	dp3 r6, r5, r5
	mul r6, lightPos.wwww, r6
	add r6, ones, -r6
	max r6, consts.xxxx, r6
	mul r7, lightColor, r6
	add r4.xyz, r4, r7
	mov outclr, r4

	end
.end
