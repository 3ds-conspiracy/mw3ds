; Skinned actor meshes on the GPU: cell.v.pica with the position blended from up to four bones (matrix palette
; skinning), so the CPU no longer rewrites every vertex of every NPC each time it moves (renderer.cpp, actors.cpp).
; The uniforms up to `consts` are cell.v.pica's, in the same order: both programs keep them in the same registers
; (renderer.cpp checks), so switching between the two keeps the frame's values.

; Uniforms
.fvec projection[4], modelView[4]
.fvec uvOffset                  ; added to the texture coordinates (scrolling water and clouds)
.fvec fogVec                    ; eye-space position . fogVec = 0 where fog starts, 1 where it is solid
.fvec posOffset, posScale       ; position = value * posScale (posOffset unused: actor space)
.fvec uvScale                   ; texture coordinate = value * uvScale
.fvec tint                      ; colour scale: day and night outdoors (1 indoors)
.fvec lightPos                  ; the light the player carries: eye-space xyz, w = 1 / radius squared
.fvec lightColor                ; its colour (0 = none)
.fvec ambientAdd                ; added to every vertex's light: Night Eye (OpenMW's ambient + 0.7 x magnitude / 100)
.fvec torchVec                  ; the player's torch lit per pixel (first person): eye-space position . torchVec = how far
                                ; out its light reaches there, 0 at the eye, 1 at its radius (renderer.cpp light ramp); (0, 0, 0, 1): none
; Stereo 3D's far depth (renderingmanager.cpp rendererSetStereoCurve): past a knee distance each doubling of the depth
; adds a share of the eye's own offset at infinity (-projection.z in the screen-width row), so the 1 / distance of a
; plain stereo view doesn't leave everything past ~10 m on one flat plane. x: the share a doubling (negated),
; y: log2 of the knee, z: the most doublings, w: unused. Nearer than the knee: nothing added
.fvec stereoCurve
.bool gammaOn                   ; the light curved by Gamma (cell.v.pica's, in the same register)
.bool lightOn                   ; the player carries a light (cell.v.pica's, in the same register)
.bool stereoOn                  ; stereo 3D's far depth (cell.v.pica's, in the same register)

; Constants
.constf consts(0.0, 1.0, 0.00392156862, 0.5)
.alias  ones      consts.yyyy
.alias  inv255    consts.zzzz
.alias  half      consts.wwww

; The palette: 3 rows (3x4, actor space) per bone the mesh uses, at most 25 (renderer.cpp kSkinBones)
.fvec bones[75]
.constf skinConsts(3.0, 0.001, 5.0, 0.0)
.alias  three     skinConsts.xxxx
.alias  gammaFloor skinConsts.yyyy
.alias  stereoFloor skinConsts.zzzz      ; the depth stereoCurve takes the log of, at least the near plane's

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1           ; x: fog amount, y: the torch's reach, looked up in the light ramp texture (renderer.cpp)
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias inclr v2
.alias inidx v3                 ; four palette entries (unsigned bytes)
.alias inwt  v4                 ; their weights, 0..255 (summing to 255)

.proc main
	; r12 = palette entries x 3 (their first rows), two at a time into the address registers (other work between a
	; mova and the first read of its register)
	mul r12, three, inidx
	mova a0.xy, r12.xy
	; r10 = vec4(bind-pose position, 1): packed shorts x the mesh's scale; r11 = weights 0..1
	mul r10.xyz, posScale, inpos
	mov r10.w,   ones
	mul r11, inv255, inwt

	; r0 = sum of weight x (bone x position), one bone at a time
	dp4 r13.x, bones[a0.x], r10
	dp4 r13.y, bones[a0.x + 1], r10
	dp4 r13.z, bones[a0.x + 2], r10
	dp4 r14.x, bones[a0.y], r10
	dp4 r14.y, bones[a0.y + 1], r10
	dp4 r14.z, bones[a0.y + 2], r10
	mova a0.xy, r12.zw
	mul r0.xyz, r11.xxxx, r13
	mul r14.xyz, r11.yyyy, r14
	add r0.xyz, r0, r14

	dp4 r13.x, bones[a0.x], r10
	dp4 r13.y, bones[a0.x + 1], r10
	dp4 r13.z, bones[a0.x + 2], r10
	dp4 r14.x, bones[a0.y], r10
	dp4 r14.y, bones[a0.y + 1], r10
	dp4 r14.z, bones[a0.y + 2], r10
	mul r13.xyz, r11.zzzz, r13
	add r0.xyz, r0, r13
	mul r14.xyz, r11.wwww, r14
	add r0.xyz, r0, r14
	mov r0.w, ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 r13.x, projection[0], r1
	dp4 r13.y, projection[1], r1
	dp4 r13.z, projection[2], r1
	dp4 r13.w, projection[3], r1
	; Stereo 3D's far depth: doublings past the knee (0 to the most), x the depth (clip space), x the eye's offset at
	; infinity in whichever row holds it (the other's z is 0)
	ifu stereoOn
		max r14, stereoFloor, r13.wwww
		lg2 r14.x, r14.x
		add r14, -stereoCurve.yyyy, r14.xxxx
		max r14, consts.xxxx, r14
		min r14, stereoCurve.zzzz, r14
		mul r14, stereoCurve.xxxx, r14
		mul r14, r13.wwww, r14
		mad r13.x, r14.xxxx, projection[0].zzzz, r13.xxxx
		mad r13.y, r14.xxxx, projection[1].zzzz, r13.yyyy
	.end
	mov outpos, r13

	mov r2, intex
	mul r2.xy, uvScale, r2
	add outtc0, uvOffset, r2

	; Fog and the torch's reach, as cell.v.pica (written whole: an output left partly unwritten hangs the real PICA)
	mov r3, consts.xxxx
	dp4 r3.x, fogVec, r1
	dp4 r3.y, torchVec, r1
	mov outtc1, r3

	; Colour, as cell.v.pica
	mul r4, inv255, inclr
	mul r4, tint, r4
	add r4.xyz, ambientAdd, r4
	; (r5.w is left as it falls: dp3 reads xyz. r1.w is 1, the point's: the falloff 1 - d^2 / r^2 is one mad, the
	; colour added another: five instructions a light, not eight, on every vertex)
	ifu lightOn
		add r5, -lightPos, r1
		dp3 r6, r5, r5
		mad r6, r6, -lightPos.wwww, r1.wwww
		max r6, consts.xxxx, r6
		mad r4.xyz, r6, lightColor, r4
	.end
	; Gamma (Options, Auto gamma): the light's rgb ^ (1 / gamma), its exponent in ambientAdd.w (renderer.cpp
	; rendererSetGamma). lg2 and ex2 take one component each; the floor keeps lg2 off 0
	ifu gammaOn
		max r8.xyz, gammaFloor, r4
		lg2 r9.x, r8.x
		lg2 r9.y, r8.y
		lg2 r9.z, r8.z
		mul r9.xyz, ambientAdd.wwww, r9
		ex2 r4.x, r9.x
		ex2 r4.y, r9.y
		ex2 r4.z, r9.z
	.end
	mov outclr, r4

	end
.end
