; Cell geometry: pre-lit vertices (lighting baked into the vertex color).

; Uniforms
.fvec projection[4], modelView[4]
.fvec uvOffset                  ; added to the texture coordinates (scrolling water and clouds)
.fvec fogVec                    ; eye-space position . fogVec = 0 where fog starts, 1 where it is solid
.fvec posOffset, posScale       ; packed s16 vertices: position = posOffset + value * posScale
.fvec uvScale                   ; texture coordinate = value * uvScale (1 for float vertices)
.fvec tint                      ; colour scale: day and night outdoors (1 indoors)
.fvec lightPos                  ; the light the player carries: eye-space xyz, w = 1 / radius squared
.fvec lightColor                ; its colour (0 = none)
.fvec ambientAdd                ; added to every vertex's light: Night Eye (OpenMW's ambient + 0.7 x magnitude / 100)
.fvec torchVec                  ; the player's torch lit per pixel (first person): eye-space position . torchVec = how far
                                ; out its light reaches there, 0 at the eye, 1 at its radius (renderer.cpp light ramp); (0, 0, 0, 1): none
; Stereo 3D's far depth (renderingmanager.cpp rendererSetStereoCurve): past a knee distance each doubling of the depth
; adds a share of the eye's own offset at infinity (-projection.z in the screen-width row), so the 1 / distance of a
; plain stereo view doesn't leave everything past ~10 m on one flat plane. x: the share a doubling (negated),
; y: log2 of the knee, z: the most doublings, w: unused. Nearer than the knee: nothing added
.fvec stereoCurve
; Outdoors, the lamps' light the night leaves alone: the batch's lamp colour x (1 - tint) / 16383, times each vertex's
; brightness of it in the position's w (convert_cell.py lamp_channel); 0 for everything else. Not in skin.v.pica: its
; bone palette overwrites this register (renderer.cpp sets it again after a skinned run)
.fvec lamp                      ; (w: the side light's -direction below)
; Outdoors, the low sun's light from the side (World::sunSide): rgb its colour on a wall square to it. A side-lit batch's
; colours carry in their alpha how much each vertex faces east, -1..1 as 0..255 (convert_cell.py side_facing; opaque
; batches, never blended: the alpha isn't one). Its direction d is +1 from the east, -1 from the west: w = 2d / 255 and
; lamp.w = -d, so alpha x w + lamp.w = facing x d (both 0 on other batches); it adds rgb x max(0, that)
.fvec sideLight
.bool gammaOn                   ; on: the light is curved by Gamma (gamma.h); first, so skin.v.pica has it in the same register
.bool lightOn                   ; on: the player carries a light (off: its terms skipped; second, as in skin.v.pica)
.bool stereoOn                  ; on: stereo 3D's far depth (stereoCurve; third, as in skin.v.pica)

; Constants
.constf consts(0.0, 1.0, 0.00392156862, 0.5)
.alias  ones      consts.yyyy
.alias  inv255    consts.zzzz
.alias  half      consts.wwww
.constf gammaConsts(0.001, 5.0, 0.0, 0.0)
.alias  gammaFloor gammaConsts.xxxx
.alias  stereoFloor gammaConsts.yyyy     ; the depth stereoCurve takes the log of, at least the near plane's

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1           ; x: fog amount, y: the torch's reach, looked up in the light ramp texture (renderer.cpp)
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	; r0 = vec4(posOffset + inpos * posScale, 1)
	mul r0.xyz, posScale, inpos
	add r0.xyz, posOffset, r0
	mov r0.w,   ones

	; r1 = modelView * r0
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 r13.x, projection[0], r1
	dp4 r13.y, projection[1], r1
	dp4 r13.z, projection[2], r1
	dp4 r13.w, projection[3], r1
	; Stereo 3D's far depth: doublings past the knee (0 to the most), x the depth (clip space), x the eye's offset at
	; infinity in whichever row holds it (the other's z is 0)
	ifu stereoOn
		max r14, stereoFloor, r13.wwww
		lg2 r14.x, r14.x
		add r14, -stereoCurve.yyyy, r14.xxxx
		max r14, consts.xxxx, r14
		min r14, stereoCurve.zzzz, r14
		mul r14, stereoCurve.xxxx, r14
		mul r14, r13.wwww, r14
		mad r13.x, r14.xxxx, projection[0].zzzz, r13.xxxx
		mad r13.y, r14.xxxx, projection[1].zzzz, r13.yyyy
	.end
	mov outpos, r13

	mov r2, intex
	mul r2.xy, uvScale, r2
	add outtc0, uvOffset, r2

	; Linear distance fog from the eye-space depth, and how far out the torch's light is: (fog, reach, 0, 0). Built in a
	; temporary and written to the output whole: the real PICA hangs when any component of an output register is
	; left unwritten (emulators don't care), which froze the game on its first 3D frame
	mov r3, consts.xxxx
	dp4 r3.x, fogVec, r1
	dp4 r3.y, torchVec, r1
	mov outtc1, r3

	; Unsigned byte colors arrive as 0..255; scaled by the time of day's tint, the lamps' share put back (one mad: the
	; night darkens the sun's and the sky's light, not theirs), plus the carried light falling off with distance:
	; lightColor x max(0, 1 - distance^2 / radius^2) (written whole; no square roots: rsq of a zero distance hung the GPU)
	mul r4, inv255, inclr
	mul r4, tint, r4
	mad r4.xyz, inpos.wwww, lamp, r4
	; the side light: facing x direction, not below 0, times its colour (four instructions)
	mul r7, sideLight.wwww, inclr.wwww
	add r7, lamp.wwww, r7
	max r7, consts.xxxx, r7
	mad r4.xyz, r7, sideLight, r4
	add r4.xyz, ambientAdd, r4
	; (r5.w is left as it falls: dp3 reads xyz. r1.w is 1, the point's: the falloff 1 - d^2 / r^2 is one mad, the
	; colour added another: five instructions a light, not eight, on every vertex)
	ifu lightOn
		add r5, -lightPos, r1
		dp3 r6, r5, r5
		mad r6, r6, -lightPos.wwww, r1.wwww
		max r6, consts.xxxx, r6
		mad r4.xyz, r6, lightColor, r4
	.end
	; Gamma (Options, Auto gamma): the light's rgb ^ (1 / gamma), its exponent in ambientAdd.w (renderer.cpp
	; rendererSetGamma). lg2 and ex2 take one component each; the floor keeps lg2 off 0
	ifu gammaOn
		max r8.xyz, gammaFloor, r4
		lg2 r9.x, r8.x
		lg2 r9.y, r8.y
		lg2 r9.z, r8.z
		mul r9.xyz, ambientAdd.wwww, r9
		ex2 r4.x, r9.x
		ex2 r4.y, r9.y
		ex2 r4.z, r9.z
	.end
	mov outclr, r4

	end
.end
